#: bin/soundconverter.py.in:250
#, python-brace-format
msgid ""
"For example {artist}/{album}/{title}. title defaults to the filename if "
"unset. Unknown tags default to \"Unknown ...\" otherwise."
msgstr ""

#: bin/soundconverter.py.in:265
msgid ""
"Quality of the converted output file. Possible values: vorbis: 0.0 - 1.0; "
"aac/m4a: 0 - 400; opus: 6 - 510; mp3 vbr: 9 (low) - 0 (high); mp3 abr: 64 - "
"320; mp3 cbr: 64 - 320; wav: 8, 16, 32 (bitdepth); flac: 0 - 8 (compression "
"strength)"
msgstr ""

